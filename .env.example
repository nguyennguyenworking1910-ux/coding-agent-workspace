# ============================================================
# Coding Agent Workspace - Local Environment
# Copy this file to .env and replace required placeholder values.
# Never commit the real .env file.
# ============================================================


# ------------------------------------------------------------
# Intent parser
# ------------------------------------------------------------

OPENAI_API_KEY=replace-with-your-openai-api-key


# ------------------------------------------------------------
# RAG database
# ------------------------------------------------------------

RAG_DB_PASSWORD=replace-with-a-random-local-password
RAG_DB_HOST=127.0.0.1
RAG_DB_PORT=5434
RAG_DB_NAME=coding_agent_rag
RAG_DB_USER=rag_user

# Optional complete connection string.
# Leave blank to construct it from the variables above.
RAG_DATABASE_URL=

RAG_DB_POOL_MIN_SIZE=1
RAG_DB_POOL_MAX_SIZE=5
RAG_DB_TIMEOUT_SECONDS=5
RAG_CLIENT_TIMEOUT_SECONDS=30


# ------------------------------------------------------------
# RAG API
# ------------------------------------------------------------

RAG_API_HOST=127.0.0.1
RAG_API_PORT=8200
RAG_API_BASE_URL=http://127.0.0.1:8200
RAG_INGEST_API_TIMEOUT_SECONDS=900


# ------------------------------------------------------------
# Local embedding model
# ------------------------------------------------------------

RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_MAX_LENGTH=1024
RAG_EMBEDDING_BATCH_SIZE=4
RAG_EMBEDDING_MAX_BATCH_SIZE=16
RAG_EMBEDDING_MAX_TEXT_CHARS=8000
RAG_TORCH_NUM_THREADS=4
RAG_MODEL_CACHE=rag-server/.model-cache


# ------------------------------------------------------------
# RAG ingestion
# ------------------------------------------------------------

RAG_INGEST_MAX_CHILDREN_PER_SOURCE=2000


# ------------------------------------------------------------
# Claude Code transcript ingestion
# ------------------------------------------------------------

# Leave blank to use ~/.claude/projects.
RAG_CLAUDE_PROJECTS_DIR=

RAG_CHAT_MAX_FILE_BYTES=52428800
RAG_CHAT_MAX_TEXT_CHARS=2000000
RAG_CHAT_QUIET_PERIOD_SECONDS=60
RAG_CHAT_MAX_INVALID_LINE_RATIO=0.05


# ------------------------------------------------------------
# Google Calendar
# ------------------------------------------------------------

# Relative credential paths continue to resolve against
# .claude/clients/.
GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CALENDAR_TOKEN=
GOOGLE_CALENDAR_SERVICE_ACCOUNT=

GOOGLE_CALENDAR_ID=primary
CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh


# ------------------------------------------------------------
# BigQuery
# ------------------------------------------------------------

# Leave blank to use the project resolved from gcloud ADC.
BIGQUERY_PROJECT=
BIGQUERY_LOCATION=US

# Optional service-account path. ADC remains the primary method.
BIGQUERY_SERVICE_ACCOUNT=

BIGQUERY_MAX_BYTES_BILLED=10737418240
BIGQUERY_MAX_ROWS=1000

# Leave blank to use the repository's default SQL template folder.
BIGQUERY_TEMPLATE_DIR=


# ------------------------------------------------------------
# Merchant Database - Bootstrap Configuration
# ------------------------------------------------------------

# Admin database for maintenance connections (role/database creation)
# For shared local cluster: use coding_agent_rag (existing RAG database)
# Must be explicitly set - never inferred from admin username
MERCHANT_ADMIN_DB=coding_agent_rag

# Administrator credentials (e.g., rag_user for RAG database cluster)
MERCHANT_ADMIN_USER=rag_user
MERCHANT_ADMIN_PASSWORD=replace-with-admin-password

# Owner role (merchant_owner) - login-enabled migration owner
MERCHANT_OWNER_PASSWORD=replace-with-owner-password

# Application role (merchant_app) - connection and schema usage
MERCHANT_DB_HOST=127.0.0.1
MERCHANT_DB_PORT=5434
MERCHANT_DB_NAME=coding_agent_merchant
MERCHANT_DB_USER=merchant_app
MERCHANT_DB_PASSWORD=replace-with-app-password
MERCHANT_DB_SSLMODE=prefer

# Alert role (merchant_alert) - connection and schema usage for alerts
MERCHANT_ALERT_USER=merchant_alert
MERCHANT_ALERT_PASSWORD=replace-with-alert-password

# Test role (merchant_test) - test database connection and schema usage with CREATE
MERCHANT_TEST_DB_NAME=coding_agent_merchant_test
MERCHANT_TEST_USER=merchant_test
MERCHANT_TEST_PASSWORD=replace-with-test-password

# Timezone
MERCHANT_TIMEZONE=Asia/Ho_Chi_Minh
