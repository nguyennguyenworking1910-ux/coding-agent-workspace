# Normalize line endings: store as LF in the repo, check out native on each OS.
* text=auto

# Force LF for cross-platform source and config.
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Force CRLF for Windows-only scripts.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
