# Client configuration (Google Calendar + BigQuery).
# Copy to .claude/clients/.env — every value is optional and has a sensible default.
#
# With none of these set and no credential files present, the client falls back to
# gcloud Application Default Credentials. That path needs the Calendar scope:
#
#   gcloud auth application-default login \
#     --scopes=openid,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/calendar

# --- Credential file locations (relative paths resolve against .claude/clients/) ---

# Desktop OAuth client secret. Present => browser consent flow on first run.
# GOOGLE_CALENDAR_CREDENTIALS=credentials.json

# Where the cached OAuth token is written after consent.
# GOOGLE_CALENDAR_TOKEN=token.json

# Service account key, for unattended runs against a shared calendar.
# GOOGLE_CALENDAR_SERVICE_ACCOUNT=service_account.json

# --- Calendar settings ---

# Which calendar to read/write. "primary" = your main calendar.
GOOGLE_CALENDAR_ID=primary

# Timezone for events created without an explicit zone.
CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh

# --- BigQuery ---
#
# Every variable below is OPTIONAL when gcloud ADC is configured:
#
#   gcloud auth application-default login
#
# With none of them set, the client uses the ADC credentials and the project gcloud
# is configured with. See .claude/documents/BIGQUERY_INTEGRATION.md.

# Project that queries are billed to and run in. Only needed when the gcloud ADC
# default project is absent or is not the one you want to query.
# BIGQUERY_PROJECT=my-project-id

# Job location. Must match where the datasets live (US, EU, asia-southeast1, ...).
# BIGQUERY_LOCATION=US

# Optional service-account key, for unattended runs without ADC. Relative paths
# resolve against .claude/clients/. The file does NOT need to exist.
# BIGQUERY_SERVICE_ACCOUNT=bigquery_service_account.json

# Cost guard: BigQuery refuses a query that would scan more than this many bytes.
# Default 10737418240 (10 GiB, ~USD 0.05 at on-demand pricing).
# BIGQUERY_MAX_BYTES_BILLED=10737418240

# Context guard: maximum rows returned to a caller. Default 1000.
# BIGQUERY_MAX_ROWS=1000

# Where .sql query templates are discovered.
# Default .claude/agents/tools/bigquery/templates
# BIGQUERY_TEMPLATE_DIR=../agents/tools/bigquery/templates
