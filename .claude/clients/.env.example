# Google Calendar client configuration.
# Copy to .claude/clients/.env — every value is optional and has a sensible default.
#
# With none of these set and no credential files present, the client falls back to
# gcloud Application Default Credentials. That path needs the Calendar scope:
#
#   gcloud auth application-default login \
#     --scopes=openid,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/calendar

# --- Credential file locations (relative paths resolve against .claude/clients/) ---

# Desktop OAuth client secret. Present => browser consent flow on first run.
# GOOGLE_CALENDAR_CREDENTIALS=credentials.json

# Where the cached OAuth token is written after consent.
# GOOGLE_CALENDAR_TOKEN=token.json

# Service account key, for unattended runs against a shared calendar.
# GOOGLE_CALENDAR_SERVICE_ACCOUNT=service_account.json

# --- Calendar settings ---

# Which calendar to read/write. "primary" = your main calendar.
GOOGLE_CALENDAR_ID=primary

# Timezone for events created without an explicit zone.
CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh
