# Claude Code transcript discovery and ingestion configuration

# Projects directory containing Claude Code session transcripts
# If empty, uses the default: ~/.claude/projects
# Each project directory contains *.jsonl session files
RAG_CLAUDE_PROJECTS_DIR=

# Maximum size of a single transcript file in bytes (default: 52428800 = 50 MB)
RAG_CHAT_MAX_FILE_BYTES=52428800

# Maximum total character count to process per transcript (default: 2000000)
RAG_CHAT_MAX_TEXT_CHARS=2000000

# Minimum seconds between duplicate message detection (default: 60)
RAG_CHAT_QUIET_PERIOD_SECONDS=60

# Maximum allowed ratio of malformed JSON lines before rejecting transcript (default: 0.05)
RAG_CHAT_MAX_INVALID_LINE_RATIO=0.05
